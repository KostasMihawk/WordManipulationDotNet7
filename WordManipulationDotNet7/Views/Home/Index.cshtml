@{
    ViewBag.Title = "Αρχική";
}

<h2>Αρχική</h2>


<style>
    .mycontainer {
        display: flex;
        flex-direction: column;
        width: 500px;
        justify-content: center;
    }

    .admin-section {
        margin-top: 30px;
        padding: 20px;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        border-radius: 10px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.2);
    }

    .admin-section h4 {
        color: white;
        margin-bottom: 10px;
    }

    .admin-section p {
        color: rgba(255,255,255,0.9);
        margin-bottom: 15px;
    }
</style>

<div class="mycontainer">
    @Html.ActionLink("Πρόσκληση Δανειστών", "CreateLoanerInvitation", "LoanerInvitation", null, new { @class = "btn btn-primary", @style = "color:white" })
    @* @Html.ActionLink("Εκθέσεις Εντολής Συνέχισης Πληστειριασμού", "CreateSunexisiPlistiriasmou", "SunexisiPlistriasmou", null, new { @class = "btn btn-primary", @style = "color:white" }) *@
    @Html.ActionLink("Εκθέσεις Εντολής Συνέχισης Πληστειριασμού  NEW", "CreateDilosi", "DilosiSunexisisNew", null, new { @class = "btn btn-primary", @style = "color:white" })
    @* @Html.ActionLink("Κατασχετήρια", "CreateKatasxetirio", "Katasxetiria", null, new { @class = "btn btn-primary", @style = "color:white" }) *@

    <div class="admin-section">
        <h4><i class="bi bi-database-fill-gear"></i> Διαχείριση Βάσης Δεδομένων</h4>
        <p>Προσθήκη και διαχείριση δικηγόρων, συμβολαιογράφων, ταμείων και άλλων δεδομένων</p>
        <a asp-controller="Admin" asp-action="Index" class="btn btn-light btn-lg w-100">
            <i class="bi bi-gear-fill"></i> Άνοιγμα Admin Panel
        </a>
    </div>
</div>