@model List<WordManipulationDotNet7.Models.EkthesiEpidoshsModel>
@{
    ViewData["Title"] = "Διαχείριση Προτύπων Εγγράφων";
}

<div class="container mt-4">
    <h2>@ViewData["Title"]</h2>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Add New Document Template Button -->
    <div class="mb-4">
        <a asp-controller="Admin" asp-action="AddDocument" class="btn btn-success">
            <i class="bi bi-plus-circle"></i> Προσθήκη Νέου Προτύπου Εγγράφου
        </a>
    </div>

    <!-- List of Document Templates -->
    <div class="card">
        <div class="card-header">
            <h4>Υπάρχοντα Πρότυπα Εγγράφων</h4>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-striped table-hover">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Προτεραιότητα</th>
                            <th>Όνομα</th>
                            <th>Τοποθεσία</th>
                            <th>Περιγραφή</th>
                            <th>Πράξη</th>
                            <th>Φυσικό Πρόσωπο</th>
                            <th>Κλείσιμο</th>
                            <th>Υπογραφή</th>
                            <th>Zone B</th>
                            <th>Ενέργειες</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Count == 0)
                        {
                            <tr>
                                <td colspan="11" class="text-center text-muted">
                                    Δεν υπάρχουν πρότυπα εγγράφων. Κάντε κλικ στο κουμπί "Προσθήκη" για να δημιουργήσετε το πρώτο.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var doc in Model)
                            {
                                <tr>
                                    <td>@doc.Id</td>
                                    <td><span class="badge bg-primary">@doc.PriorityNumber</span></td>
                                    <td><strong>@doc.Name</strong></td>
                                    <td>@doc.Location</td>
                                    <td>@(doc.Perigrafh ?? "-")</td>
                                    <td>
                                        @if (doc.Praxh.HasValue)
                                        {
                                            <span class="badge bg-@(doc.Praxh.Value ? "success" : "secondary")">
                                                @(doc.Praxh.Value ? "Ναι" : "Όχι")
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">-</span>
                                        }
                                    </td>
                                    <td>
                                        <span class="badge bg-@(doc.FusikoProswpo ? "info" : "warning")">
                                            @(doc.FusikoProswpo ? "Ναι" : "Όχι")
                                        </span>
                                    </td>
                                    <td>
                                        <span class="badge bg-secondary">@doc.HasKleisimo</span>
                                    </td>
                                    <td>
                                        <span class="badge bg-info">@doc.Signature</span>
                                    </td>
                                    <td>
                                        @if (doc.ZoneB.HasValue)
                                        {
                                            <span class="badge bg-@(doc.ZoneB.Value ? "success" : "secondary")">
                                                @(doc.ZoneB.Value ? "Ναι" : "Όχι")
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">-</span>
                                        }
                                    </td>
                                    <td>
                                        <a asp-controller="Admin" asp-action="EditDocument" asp-route-id="@doc.Id" 
                                           class="btn btn-warning btn-sm me-1" title="Επεξεργασία">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <form asp-controller="Admin" asp-action="DeleteDocument" method="post" style="display:inline;"
                                              onsubmit="return confirm('Είστε σίγουροι ότι θέλετε να διαγράψετε αυτό το πρότυπο εγγράφου;');">
                                            <input type="hidden" name="id" value="@doc.Id" />
                                            <button type="submit" class="btn btn-danger btn-sm" title="Διαγραφή">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="mt-3">
        <a asp-controller="Admin" asp-action="Index" class="btn btn-secondary">Επιστροφή στο Admin Panel</a>
        <a asp-controller="Home" asp-action="Index" class="btn btn-secondary">Επιστροφή στην Αρχική</a>
    </div>
</div>

<style>
    .table th {
        background-color: #f8f9fa;
        white-space: nowrap;
    }
    .table td {
        vertical-align: middle;
    }
</style>
