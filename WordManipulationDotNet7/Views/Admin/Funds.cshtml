@model List<WordManipulationDotNet7.Models.Fund>
@{
    ViewData["Title"] = "Διαχείριση Ταμείων";
}

<div class="container mt-4">
    <h2>@ViewData["Title"]</h2>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Add New Fund Form -->
    <div class="card mb-4">
        <div class="card-header">
            <h4>Προσθήκη Νέου Ταμείου</h4>
        </div>
        <div class="card-body">
            <form asp-controller="Admin" asp-action="AddFund" method="post">
                <div class="row">
                    <div class="col-md-6">
                        <label for="Name" class="form-label">Όνομα Ταμείου</label>
                        <input type="text" class="form-control" name="Name" required />
                    </div>
                    <div class="col-md-6">
                        <label for="Description" class="form-label">Περιγραφή</label>
                        <input type="text" class="form-control" name="Description"
                               placeholder="π.χ. με έδρα το Δουβλίνο Ιρλανδίας" />
                    </div>
                </div>
                <div class="row mt-3">
                    <div class="col-md-6">
                        <label for="MAEDAP" class="form-label">ΜΑΕΔΑΠ</label>
                        <input type="text" class="form-control" name="MAEDAP" />
                    </div>
                    <div class="col-md-6">
                        <label for="MAEDAPAdress" class="form-label">Διεύθυνση ΜΑΕΔΑΠ</label>
                        <input type="text" class="form-control" name="MAEDAPAdress" />
                    </div>
                </div>
                <div class="row mt-3">
                    <div class="col-md-12">
                        <button type="submit" class="btn btn-primary">Προσθήκη Ταμείου</button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- List of Funds -->
    <div class="card">
        <div class="card-header">
            <h4>Υπάρχοντα Ταμεία</h4>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-striped">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Όνομα</th>
                            <th>Περιγραφή</th>
                            <th>ΜΑΕΔΑΠ</th>
                            <th>Ενέργειες</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var fund in Model)
                        {
                            <tr>
                                <td>@fund.Id</td>
                                <td><strong>@fund.Name</strong></td>
                                <td>@fund.Description</td>
                                <td>@fund.MAEDAP</td>
                                <td>
                                    <a asp-controller="Admin" asp-action="EditFund" asp-route-id="@fund.Id" class="btn btn-warning btn-sm me-1">Επεξεργασία</a>
                                    <form asp-controller="Admin" asp-action="DeleteFund" method="post" style="display:inline;"
                                          onsubmit="return confirm('Είστε σίγουροι ότι θέλετε να διαγράψετε αυτό το ταμείο;');">
                                        <input type="hidden" name="id" value="@fund.Id" />
                                        <button type="submit" class="btn btn-danger btn-sm">Διαγραφή</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="mt-3">
        <a asp-controller="Admin" asp-action="Baillifs" class="btn btn-secondary">Επιμελητές</a>
        <a asp-controller="Admin" asp-action="Attorneys" class="btn btn-secondary">Δικηγόροι</a>
        <a asp-controller="Admin" asp-action="Index" class="btn btn-secondary">Admin Panel</a>
        <a asp-controller="Home" asp-action="Index" class="btn btn-secondary">Αρχική</a>
    </div>
</div>

<style>
    .table th {
        background-color: #f8f9fa;
    }
    .table-responsive {
        max-height: 600px;
        overflow-y: auto;
    }
</style>
